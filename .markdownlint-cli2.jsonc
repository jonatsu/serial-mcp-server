/*
 * Configuration for MarkdownLint-CLI2:
 * https://github.com/DavidAnson/markdownlint-cli2
 */
{
  // Enable schema + autocompletion in editors
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.23.3/schema/markdownlint-cli2-config-schema.json",

  // Only fix on demand (override with --fix)
  "fix": false,

  // Use markdownlint's built-in YAML frontmatter handling. A custom regex without
  // multiline anchors causes the closing delimiter to be linted as a heading.

  // For full information on the options and defaults, see:
  // https://github.com/DavidAnson/markdownlint/blob/v0.41.1/README.md#rules--aliases
  // https://github.com/DavidAnson/markdownlint/blob/v0.41.1/schema/.markdownlint.yaml
  "config": {
    "default": true,

    // MD003: Use only ATX-style headings (e.g., # Heading 1)
    "heading-style": {
      "style": "atx",
    },

    // MD004: mdformat owns list-marker rewriting and emits one marker style.
    "ul-style": {
      "style": "consistent",
    },

    // MD007: Nested unordered-list indentation width
    "ul-indent": {
      "indent": 2,
      "start_indented": false,
    },

    // MD009: No trailing spaces, so no two-space hard breaks. Hard breaks are a trailing backslash, which is visible
    // in the source and survives editors that trim whitespace; mdformat writes every hard break that way.
    "no-trailing-spaces": {
      "br_spaces": 0,
    },

    // MD010: Disallow hard tabs, except inside code blocks
    "no-hard-tabs": {
      "code_blocks": false,
      "spaces_per_tab": 1,
    },

    // MD012: Allow at most 2 consecutive blank lines
    "no-multiple-blanks": {
      "maximum": 2,
    },

    // MD013: Prose lines at most 120 characters. Code blocks and tables are exempt, and markdownlint skips
    // frontmatter, which is why the limit lives here and not in .editorconfig. mdformat keeps wrapping as written
    // (`wrap = "keep"`), so this rule only reports and never competes with the formatter.
    "line-length": {
      "line_length": 120,
      "heading_line_length": 120,
      "headings": true,
      "code_blocks": false,
      "tables": false,
      "stern": true,
      "strict": false,
    },

    // MD014: Don't require fenced code blocks to show example command output
    "commands-show-output": false,

    // MD022: Don't require blank lines around headings
    "blanks-around-headings": false,

    // MD024: Allow duplicate headings when they are in different sections
    "no-duplicate-heading": {
      "siblings_only": true,
    },

    // MD025: Require exactly one top-level heading per document. A frontmatter `title` is metadata, not a heading.
    "single-title": {
      "front_matter_title": "",
    },

    // MD031: Don't require blank lines around fenced code blocks
    "blanks-around-fences": false,

    // MD033: Permit safe inline HTML elements often used in docs
    "no-inline-html": {
      "allowed_elements": [
        "p",
        "a",
        "img",
        "br",
        "sub",
        "sup",
        "details",
        "summary",
        "kbd",
      ],
    },

    // MD034: Allow bare URLs (not just <angle-bracket> or [link]() form)
    "no-bare-urls": false,

    // MD036: Allow emphasis/strong text that reads like a heading
    "no-emphasis-as-heading": false,

    // MD040: Don't require a language tag on fenced code blocks
    "fenced-code-language": false,

    // MD041: Don't require the document to start with a top-level heading
    "first-line-heading": false,

    // MD046: Enforce fenced code blocks
    "code-block-style": {
      "style": "fenced",
    },

    // MD049: Enforce consistent emphasis markers
    "emphasis-style": {
      "style": "consistent",
    },
    // MD050: Enforce consistent strong markers
    "strong-style": {
      "style": "consistent",
    },

    // MD029: Ordered-list markers must actually increment (1, 2, 3, ...)
    "ol-prefix": {
      "style": "ordered",
    },

    // MD060: Disabled after markdownlint 0.41.0 autofix destroyed table cells.
    // A basic 0.41.1 compact/aligned probe preserved content, but broader evidence is still required.
    "table-column-style": false,
  },

  // Use a specific formatter (only valid at root)
  "outputFormatters": [["markdownlint-cli2-formatter-default"]],
}
